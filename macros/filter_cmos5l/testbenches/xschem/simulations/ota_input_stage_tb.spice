*.iopin VDD
*.ipin VI_P
*.ipin VI_N
*.opin VO_N
*.opin VO_P
XM12 VO_N vfb1 VSS VSS sg13_lv_nmos w=4u l=0.5u ng=8 m=1 mm_ok=1
XM13 VO_P vfb1 VSS VSS sg13_lv_nmos w=4u l=0.5u ng=8 m=1 mm_ok=1
XM18 VO_N VI_P viref1 viref1 sg13_lv_pmos w=48.5u l=0.13u ng=10 m=1 mm_ok=1
XM19 VO_P VI_N viref1 viref1 sg13_lv_pmos w=48.5u l=0.13u ng=10 m=1 mm_ok=1
I0 VDD viref1 520u
xr1 vfb1 VO_N VO_P VSS rstring_cm
.ends


* expanding   symbol:  rstring_cm.sym # of pins=4
