xota1 vi_ota_n vo_ota_p vo_ota_n vi_ota_p vcmi ota_fd_2pole GM=2.53m RO=434.5k CO=0.366p RP=0 CP=0.1p VCMO=0.75 I0=100u
XR5 voutp1 net2 GND rhigh w=0.5e-6 l=65e-6 m=1 b=0 mm_ok=1
